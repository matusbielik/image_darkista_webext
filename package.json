{
  "name": "image-darkista-webext",
  "description": "Web extension for inverting images while preserving the original hue.",
  "author": "Matúš Bielik",
  "license": "MIT",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@types/chrome": "0.3.5",
    "happy-dom": "^20.11.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wxt": "^0.21.4"
  }
}
